{
  "name": "gather-join-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && WRANGLER_WRITE_LOGS=false vite build",
    "build:staging": "tsc -b && WRANGLER_WRITE_LOGS=false vite build --mode staging",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:security": "vitest run src/security",
    "start": "supabase start",
    "stop": "supabase stop --no-backup",
    "reset": "supabase db reset --local",
    "verify": "GATHER_JOIN_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:58322/postgres node scripts/verify-probe.mjs",
    "verify:p1-02": "node scripts/verify-domain-schema.mjs",
    "verify:p1-04": "bash scripts/verify-p1-04.sh",
    "verify:p1-05": "bash scripts/verify-p1-05.sh",
    "verify:p1-06-08": "bash scripts/verify-p1-06-08.sh",
    "verify:p1-06-08:concurrency": "node scripts/verify-p1-06-08-concurrency.mjs",
    "concurrency": "GATHER_JOIN_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:58322/postgres vitest run scripts/concurrency-harness.test.ts",
    "test:p1-01": "pnpm reset && pnpm verify && pnpm reset && pnpm verify && pnpm concurrency",
    "smoke": "node scripts/smoke.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "jose": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.2",
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postgres": "^3.4.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
