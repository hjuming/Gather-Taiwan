{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gather-join",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-02",
  // Same-origin path routing under the main site's domain (not a separate
  // subdomain) so Supabase Auth session storage and LINE Login state share
  // naturally with no cross-origin cookie handling. This route intercepts
  // only /app/* on gather.wedopr.com; every other path on that zone keeps
  // being served by the existing "gather-taiwan" Cloudflare Pages project
  // (Workers Routes take precedence over Pages custom domains only for the
  // paths they explicitly match).
  "routes": [
    { "pattern": "gather.wedopr.com/app/*", "zone_name": "wedopr.com" }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  // Non-secret LineAuthEnv fields: public project URL, public LINE channel
  // ID (already visible in the OAuth authorize URL), and our own domain
  // strings. The two sensitive LineAuthEnv fields (LINE channel secret,
  // Supabase elevated-access key) are set separately via
  // `wrangler secret put` (never committed).
  "vars": {
    "SUPABASE_URL": "https://anklbpkyesdmsubyfcna.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Qc-0shSK0ISVXiWmo8AtaQ_Wmu_5xU7",
    "LINE_CHANNEL_ID": "2010930927",
    "LINE_CALLBACK_URL": "https://gather.wedopr.com/app/line/callback",
    "APP_BASE_URL": "https://gather.wedopr.com/app"
  }
}
